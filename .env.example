# ──────────────────────────────────────────────────────────────────────────────
# JruJu TV — Environment Variables
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Service Role Key (server-side only — NEVER expose to client) ─────
# Used by the /api/push/resubscribe route to bypass RLS for subscription rotation.
# Get from Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── YouTube Data API v3 (Server-side only) ────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key-here

# ── Web Push / VAPID Keys ─────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the client/browser.
# VAPID_PRIVATE_KEY must ONLY be in Supabase Edge Function secrets — never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY → set ONLY in Supabase Dashboard → Edge Functions → Secrets

# ── Keep-Alive / Self-Ping ────────────────────────────────────────────────────
# RENDER_EXTERNAL_URL is set AUTOMATICALLY by Render — do not set it manually.
# It provides the public URL (e.g. https://jrujutv.onrender.com) used by the
# server-side self-pinger to generate external traffic.
#
# Fallback if RENDER_EXTERNAL_URL isn't available (e.g. non-Render hosting):
# SELF_URL=https://your-app.example.com
#
# Set to "false" to disable the server-side self-pinger:
# KEEP_ALIVE_ENABLED=false
